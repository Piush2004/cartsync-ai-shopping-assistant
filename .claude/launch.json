{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "apps/api/venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--reload", "--app-dir", "apps/api", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    }
  ]
}

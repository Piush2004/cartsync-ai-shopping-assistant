rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /userPreferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /measurementProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /avatars/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /productCache/{productId} {
      allow read: if true;
      allow write: if false; 
    }

    match /computeQueue/{jobId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update, delete: if false; 
    }

    match /vtonJobs/{jobId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /chatSessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    match /chatSummaries/{summaryId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    
    match /transactions/{txId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /agentLogs/{logId} {
      allow read, write: if false; // Backend cloud functions only
    }
  }
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (apps/api has its own .gitignore too, but the legacy python/,
# local-compute/, functions/ trees do not; these patterns are bare so they
# match at any depth)
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/

# local-compute checks in a portable CPython distribution + a full pip venv
# under these two paths -- ~4.5GB of third-party binaries, not source, and
# the .venv/ pattern above already covers .venv but this is explicit for
# clarity on why these paths in particular were untracked.
/local-compute/.venv/
/local-compute/python311/

# sqlite dev databases (apps/api/.gitignore already has *.db; this covers
# any other tree, e.g. a future local-compute/python re-run)
*.db
*.sqlite
*.sqlite3
